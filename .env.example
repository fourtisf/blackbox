# ---------- Shared ----------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_HOST=127.0.0.1
API_PORT=4000

# ---------- Database ----------
DATABASE_URL=postgresql://blackbox:change-me@127.0.0.1:5432/blackbox
REDIS_URL=redis://127.0.0.1:6379

# ---------- Chain ----------
# Which network the app uses: local | testnet | mainnet
NETWORK=local
# Local development runs against anvil: pnpm --filter contracts deploy:local
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
RPC_WS_URL=
EXPLORER_URL=
# Robinhood Chain. NOT YET CONFIRMED: verify against official Robinhood Chain docs (Milestone 4) before use.
#   Mainnet: CHAIN_ID=4663  RPC_URL=https://rpc.mainnet.chain.robinhood.com  EXPLORER_URL=https://robinhoodchain.blockscout.com
TESTNET_CHAIN_ID=
TESTNET_RPC_URL=
TESTNET_EXPLORER_URL=

# ---------- Contracts ----------
# Addresses are read from packages/contracts/deployments/<CHAIN_ID>.json (written by the deploy script).
# Set these only to override that file.
AGENT_REGISTRY_ADDRESS=
SEAL_REGISTRY_ADDRESS=
USDG_ADDRESS=

# ---------- Relayer (sponsored seals) ----------
RELAYER_PRIVATE_KEY=
RELAYER_MIN_BALANCE_ETH=0.02

# ---------- Contract deploy (deploy machine only, remove afterwards) ----------
DEPLOYER_PRIVATE_KEY=
BLOCKSCOUT_API_URL=

# ---------- Auth ----------
SESSION_SECRET=change-me-32-bytes-min
SIWE_DOMAIN=localhost:3000

# ---------- Telegram alerts ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
OPS_TELEGRAM_CHAT_ID=

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
